+#ifdef __APPLE__
+bool PipelineCache::checkpoint_enabled() {
+    static const bool enabled = [] {
+        const char *value = std::getenv("VITA3K_ASYNC_PIPELINE_CHECKPOINT");
+        return value && std::strcmp(value, "1") == 0;
+    }();
+    return enabled;
+}
+
+bool PipelineCache::checkpoint(bool closing) {
+    // Called by the render thread during play and only after its join on exit.
+    if (!closing && checkpoint_writer.busy())
+        return false;
+    if (!checkpoint_writer.finish())
+        LOG_ERROR("Previous pipeline checkpoint failed; retrying with current cache");
+
+    const auto start = std::chrono::steady_clock::now();
+    vk_checkpoint::Snapshot snapshot;
+    snapshot.shader_file = state.shaders_path / "hashs-vk.dat";
+    snapshot.pipeline_file = state.shaders_path / fmt::format("pipeline-cache-vk{}.dat", shader::CURRENT_VERSION);
+    snapshot.magic = pipeline_cache_magic;
+    {
+        std::lock_guard<std::mutex> lock(shaders_mutex);
+        snapshot.shaders = vk_checkpoint::shader_bytes(state.shaders_cache_hashs, shader::CURRENT_VERSION, state.get_features_mask());
+    }
+    // Only the same upstream caller touches the Vulkan driver or live maps.
+    snapshot.driver = state.device.getPipelineCacheData(pipeline_cache);
+    snapshot.keys.reserve(pipelines.size());
+    for (const auto &[key, unused] : pipelines)
+        snapshot.keys.push_back(key);
+    const auto elapsed_ms = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - start).count();
+    LOG_INFO("Pipeline checkpoint snapshot: {} ms, {} driver bytes, final {}", elapsed_ms, snapshot.driver.size(), closing);
+    auto persist = [](const vk_checkpoint::Snapshot &data) {
+        const auto t = std::chrono::steady_clock::now();
+        const bool ok = vk_checkpoint::persist(data);
+        LOG_INFO("Pipeline checkpoint disk write: {} ms, success {}", std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - t).count(), ok);
+        return ok;
+    };
+    if (closing)
+        return persist(snapshot);
+    return checkpoint_writer.start(std::move(snapshot), persist);
+}
+#endif
+
