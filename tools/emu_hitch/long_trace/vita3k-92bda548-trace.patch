diff --git a/vita3k/util/include/util/long_present_trace.h b/vita3k/util/include/util/long_present_trace.h
new file mode 100644
index 00000000..a0b33a01
--- /dev/null
+++ b/vita3k/util/include/util/long_present_trace.h
@@ -0,0 +1,67 @@
+#pragma once
+
+#include <util/log.h>
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <string_view>
+#include <type_traits>
+
+namespace long_present {
+inline bool enabled() {
+    static const bool active = [] {
+        const char *val = std::getenv("VITA3K_LONG_PRESENT_TRACE");
+        const bool on = val && std::string_view(val) == "1";
+        if (on)
+            LOG_INFO("long-present: enabled threshold_us 50000; phases overlap");
+        return on;
+    }();
+    return active;
+}
+
+// Store only slow phases. Defer their logs until the enclosing operation is
+// done so a slow child's logging is not included in its parent's measurement.
+template<class Clock = std::chrono::steady_clock>
+class Batch {
+    using Stamp = typename Clock::time_point;
+    struct Event { const char *name; int64_t us; Stamp end; bool has_result; int64_t result; };
+    Event events[5];
+    unsigned count = 0;
+    const bool on = enabled();
+    void note(const char *name, Stamp begin, bool has_result, int64_t result) {
+        if (!on) return;
+        const auto end = Clock::now();
+        const auto us = std::chrono::duration_cast<std::chrono::microseconds>(end - begin).count();
+        if (us > 50000 && count < 5)
+            events[count++] = {name, us, end, has_result, result};
+    }
+public:
+    Stamp start() const { return on ? Clock::now() : Stamp{}; }
+    void returned(const char *name, Stamp begin, int64_t result) {
+        note(name, begin, true, result);
+    }
+    template<class Operation>
+    auto call(const char *name, Operation op) {
+        if (!on) return op();
+        const auto begin = Clock::now();
+        if constexpr (std::is_void_v<decltype(op())>) {
+            op();
+            note(name, begin, false, 0);
+        } else {
+            auto result = op();
+            returned(name, begin, static_cast<int64_t>(result));
+            return result;
+        }
+    }
+    ~Batch() {
+        for (unsigned i = 0; i < count; ++i) {
+            const auto &e = events[i];
+            const auto lag = std::chrono::duration_cast<std::chrono::microseconds>(Clock::now() - e.end).count();
+            if (e.has_result)
+                LOG_INFO("long-present: phase {} elapsed_us {} ended_ago_us {} result {}", e.name, e.us, lag, e.result);
+            else
+                LOG_INFO("long-present: phase {} elapsed_us {} ended_ago_us {} result void", e.name, e.us, lag);
+        }
+    }
+};
+} // namespace long_present
