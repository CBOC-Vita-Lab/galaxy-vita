@@ -588,6 +588,21 @@
 	DEPTHBUFFER_READY
 };
 
+// VP23_DS_LEAKFIX (Galaxy vp23, patch 0024 = upstream fbb190f "Fix memory leak on depthstencil with stencil destruction"): a hidden
+// depth buffer that has a stencil surface gives both to the garbage collector, not the depth data only. (Galaxy never asks for stencil,
+// so for it the stencil pointer is always NULL and nothing changes.)
+#if defined(VP23_DS_LEAKFIX) && !defined(DEPTH_STENCIL_HACK)
+static inline __attribute__((always_inline)) void mark_depth_stencil_as_dirty(SceGxmDepthStencilSurface *surface) {
+	mark_as_dirty(surface->depthData);
+	if (surface->stencilData) {
+		mark_as_dirty(surface->stencilData);
+	}
+}
+#define VGL_MARK_DS_DIRTY(s) mark_depth_stencil_as_dirty(s)
+#else
+#define VGL_MARK_DS_DIRTY(s) mark_as_dirty((s)->depthData)
+#endif
+
