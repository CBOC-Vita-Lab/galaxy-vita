+// (patch 0036) the same, for texture storage: the spill counter files it under "textures" and GXV_VRAM_STRICT's hook may run for it.
+extern uint32_t vgl_spill_kind; // 0 other, 1 texture, 2 render target (vglSpillSetKind)
+static inline __attribute__((always_inline)) void *gpu_alloc_mapped_for_gpu_tex(size_t size) {
