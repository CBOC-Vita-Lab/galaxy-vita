+// (patch 0036, vglGetSpillStats) allocations that wanted video memory (every gpu_alloc_mapped_aligned_for_gpu starts there) and were
+// given main memory, physically contiguous memory, common dialog memory or newlib memory instead: count and KiB by kind (other,
+// texture, render target) and pool (main, phycont, cdlg, external). Always counted: two adds and a branch only when it spilled.
+uint32_t vgl_spill_kind = 0;
+static uint32_t vgl_spill_n[3][4];
+static uint64_t vgl_spill_bytes[3][4];
+static uint32_t vgl_strict_tries = 0, vgl_strict_saved = 0, vgl_strict_failed = 0, vgl_strict_freed = 0; // tries, new requests recorded, spilled anyway, requests already waiting
+static uint32_t (*vgl_strict_hook)(uint32_t size) = NULL; // GXV_VRAM_STRICT: the host's request; returns 1 when it recorded a new one (it drains at the next present)
+static int vgl_strict_in_hook = 0;
+static inline __attribute__((always_inline)) void vgl_spill_note(size_t size, int pool) {
+	const uint32_t k = vgl_spill_kind < 3 ? vgl_spill_kind : 0;
+	vgl_spill_n[k][pool]++;
+	vgl_spill_bytes[k][pool] += size;
+}
+uint32_t vglSpillSetKind(uint32_t kind) { // returns the previous kind; the host sets 2 around a render target's storage and puts it back
+	const uint32_t old = vgl_spill_kind;
+	vgl_spill_kind = kind < 3 ? kind : 0;
+	return old;
+}
+// out[0 + 4 * kind + pool]: spilled allocations, out[12 + 4 * kind + pool]: KiB; out[24] strict tries, [25] strict requests recorded,
+// [26] spilled anyway (every try: the request is served at the present), [27] tries that found a request already waiting. Fills min(n, 28) words.
+void vglGetSpillStats(uint32_t *out, uint32_t n) {
+	uint32_t v[28];
+	for (int k = 0; k < 3; k++)
+		for (int p = 0; p < 4; p++) {
+			v[4 * k + p] = vgl_spill_n[k][p];
+			v[12 + 4 * k + p] = (uint32_t)(vgl_spill_bytes[k][p] >> 10);
+		}
+	v[24] = vgl_strict_tries; v[25] = vgl_strict_saved; v[26] = vgl_strict_failed; v[27] = vgl_strict_freed;
+	for (uint32_t i = 0; i < n && i < 28; i++) out[i] = v[i];
+}
+// GXV_VRAM_STRICT: with a hook set, a texture allocation that finds no video memory calls hook(size), which only records a request (no wait, no free, no log here),
+// and then takes the old way (spill) this once. The host serves the request at its next present. NULL: off.
+void vglSetSpillStrictHook(uint32_t (*hook)(uint32_t size)) {
+	vgl_strict_hook = hook;
+}
