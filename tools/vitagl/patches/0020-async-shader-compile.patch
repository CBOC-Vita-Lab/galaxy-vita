+// Asynchronous shader compilation (patch 0020, needs HAVE_SHADER_CACHE). vglEnableAsyncCompiler (once, on the GL thread, before any
+// worker exists) makes the translator and the runtime compiler take a recursive lock, so that a worker thread may call
+// vglCompileShaderPairToCache while the GL thread runs; it returns 0 or a negative error and does nothing a second time. Never called:
+// no lock exists and vitaGL behaves as before. vglCompileShaderPairToCache(vs, fs, fsLowPrecision, &compiled) translates the GLSL pair
+// (texts as glShaderSource joins them), compiles what the shader cache (vglSetShaderCachePath) lacks and writes it there, creating no GL
+// object and touching no GXM state, so any thread but the GL thread's may call it. 0: both entries are in the cache; else see
+// custom_shaders.c (bit 0x100: a failure; -1: cannot run).
+int vglEnableAsyncCompiler(void);
+int vglCompileShaderPairToCache(const char *vs_src, const char *fs_src, GLboolean fs_low_precision, int *compiled);
+
 // Allows to swap between triple and double buffering. Default value: GL_TRUE.
