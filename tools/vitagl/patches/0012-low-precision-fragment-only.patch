diff --git a/source/custom_shaders.c b/source/custom_shaders.c
index 5779715..cc72fa9 100644
--- a/source/custom_shaders.c
+++ b/source/custom_shaders.c
@@ -4113,6 +4113,14 @@ void vglAddSemanticBindingHint(const GLchar *const *varying, GLenum type) {
 
 void vglUseLowPrecision(GLboolean val) {
 	glsl_precision_low = val;
+	glsl_precision_fs_only = GL_FALSE;
+}
+
+// Low precision for the fragment shaders only: with VGL_MODE_POSTPONED the vertex and the fragment shader of a program are both
+// translated inside glLinkProgram, so vglUseLowPrecision would also turn the vertex shader's float into half (positions).
+void vglUseLowPrecisionFragmentOnly(GLboolean val) {
+	glsl_precision_low = val;
+	glsl_precision_fs_only = val;
 }
 
 void vglSetSemanticBindingMode(GLenum mode) {
diff --git a/source/utils/glsl_utils.c b/source/utils/glsl_utils.c
index a9e8aca..23f93b2 100644
--- a/source/utils/glsl_utils.c
+++ b/source/utils/glsl_utils.c
@@ -166,6 +166,7 @@ int glsl_custom_bindings_num = 0;
 int glsl_current_ref_idx = 0;
 GLboolean glsl_is_first_shader = GL_TRUE;
 GLboolean glsl_precision_low = GL_FALSE;
+GLboolean glsl_precision_fs_only = GL_FALSE;
 GLenum glsl_sema_mode = VGL_MODE_POSTPONED;
 binds_map glsl_bindings_map;
 #ifdef HAVE_FIXED_ATTRIBUTES
@@ -1300,7 +1301,7 @@ void glsl_translator_process(shader *s) {
 	GLboolean hasPointSize = GL_FALSE, hasFragDepth = GL_FALSE, hasFrontFacing = GL_FALSE, hasFrontColor = GL_FALSE;
 	GLboolean hasColor = GL_FALSE;
 	size += strlen(glsl_hdr);
-	if (glsl_precision_low)
+	if (glsl_precision_low && (!glsl_precision_fs_only || s->type == GL_FRAGMENT_SHADER))
 		size += strlen(glsl_precision_hdr);
 #ifdef HAVE_FFP_SHADER_SUPPORT
 	size += strlen(glsl_ffp_hdr);
@@ -1431,7 +1432,7 @@ void glsl_translator_process(shader *s) {
 			strcat(s->source, "varying in float4 gl_Color : COLOR;\n");
 	}
 	strcat(s->source, glsl_hdr);
-	if (glsl_precision_low)
+	if (glsl_precision_low && (!glsl_precision_fs_only || s->type == GL_FRAGMENT_SHADER))
 		strcat(s->source, glsl_precision_hdr);
 	
 #ifdef HAVE_FFP_SHADER_SUPPORT
