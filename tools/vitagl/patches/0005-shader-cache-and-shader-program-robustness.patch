diff --git a/source/utils/shader_binary.h b/source/utils/shader_binary.h
new file mode 100644
index 0000000..051ab21
--- /dev/null
+++ b/source/utils/shader_binary.h
@@ -0,0 +1,32 @@
+/* GXP fixed header and parameter layout used by vglProgramGetParameterBase.
+ * Bounds-check before calling native accessors, which do not take a byte length.
+ * This validates layout, not the shader instruction stream. */
+static uint32_t shader_binary_word(const uint8_t *p, size_t offset) {
+	uint32_t value;
+	vgl_fast_memcpy(&value, p + offset, sizeof(value));
+	return value;
+}
+
+static GLboolean shader_binary_valid(const void *data, size_t length, GLenum type) {
+	const uint8_t *p = (const uint8_t *)data;
+	if (!p || length < 156 || shader_binary_word(p, 0) != 0x00505847)
+		return GL_FALSE;
+	size_t size = shader_binary_word(p, 8);
+	if (size < 156 || size > length || ((shader_binary_word(p, 20) & 1) != (type == GL_FRAGMENT_SHADER)))
+		return GL_FALSE;
+	uint32_t count = shader_binary_word(p, 36), offset = shader_binary_word(p, 40);
+	if (offset > size - 40 || count > (size - 40 - offset) / 16)
+		return GL_FALSE;
+	size_t table = 40 + offset;
+	if (count && (table < 156 || (table & 3)))
+		return GL_FALSE;
+	for (uint32_t i = 0; i < count; ++i) {
+		size_t at = table + (size_t)i * 16;
+		int32_t relative;
+		vgl_fast_memcpy(&relative, p + at, sizeof(relative));
+		int64_t name = (int64_t)at + relative;
+		if (name < 0 || (uint64_t)name >= size || !memchr(p + name, 0, size - (size_t)name))
+			return GL_FALSE;
+	}
+	return GL_TRUE;
+}
diff --git a/source/utils/shader_cache_io.h b/source/utils/shader_cache_io.h
new file mode 100644
index 0000000..89e0b94
--- /dev/null
+++ b/source/utils/shader_cache_io.h
@@ -0,0 +1,49 @@
+#ifndef VGL_SHADER_CACHE_IO_H
+#define VGL_SHADER_CACHE_IO_H
+
+/* Called only by the GL-owning thread after successful program registration. */
+static void vgl_cache_compiled_shader(shader *s, GLboolean save_bindings, const char *filename) {
+	char parent[256], temporary[260];
+	if (!filename || !s->prog || s->size < sizeof(uint32_t))
+		return;
+	size_t length = strlen(filename);
+	const char *slash = strrchr(filename, '/');
+	if (length >= sizeof(parent) || !slash || slash == filename || !slash[1])
+		return;
+	memcpy(parent, filename, slash - filename);
+	parent[slash - filename] = 0;
+	int n = snprintf(temporary, sizeof(temporary), "%s.tmp", filename);
+	if (n < 0 || (size_t)n >= sizeof(temporary))
+		return;
+
+	/* Parents exist from initialization; only the bucket is created on a miss. */
+	sceIoMkdir(parent, 0777);
+	SceUID f = sceIoOpen(temporary, SCE_O_CREAT | SCE_O_WRONLY | SCE_O_TRUNC, 0777);
+	if (f < 0)
+		return;
+	size_t size = 0;
+	void *data = serialize_shader(NULL, &size, s, save_bindings);
+	GLboolean complete = data && size >= sizeof(uint32_t) + s->size;
+	for (size_t written = 0; complete && written < size;) {
+		int count = sceIoWrite(f, (uint8_t *)data + written, size - written);
+		if (count <= 0 || (size_t)count > size - written)
+			complete = GL_FALSE;
+		else
+			written += count;
+	}
+	if (sceIoClose(f) < 0)
+		complete = GL_FALSE;
+	vgl_free(data);
+	/* Never truncate a final entry or remove one when publication fails. */
+	if (complete && sceIoRename(temporary, filename) < 0) {
+		/* The Vita's rename does not replace an existing file: an entry that was just rejected as invalid would otherwise
+		   stay for ever (recompiled on every start). Only a complete new entry replaces it. */
+		sceIoRemove(filename);
+		if (sceIoRename(temporary, filename) < 0)
+			complete = GL_FALSE;
+	}
+	if (!complete)
+		sceIoRemove(temporary);
+}
+
+#endif
diff --git a/source/utils/shader_candidate.h b/source/utils/shader_candidate.h
new file mode 100644
index 0000000..b6fd80e
--- /dev/null
+++ b/source/utils/shader_candidate.h
@@ -0,0 +1,24 @@
+/* Unregistered candidates own their bytes and metadata until commit. */
+static void discard_shader_candidate(shader *s) {
+	while (s->mat) {
+		matrix_uniform *next = (matrix_uniform *)s->mat->chain;
+		vgl_free(s->mat);
+		s->mat = next;
+	}
+	while (s->unif_blk) {
+		block_uniform *next = (block_uniform *)s->unif_blk->chain;
+		vgl_free(s->unif_blk);
+		s->unif_blk = next;
+	}
+	vgl_free((void *)s->prog);
+	s->prog = NULL;
+}
+
+static void commit_shader_candidate(shader *s, const shader *candidate) {
+	s->prog = candidate->prog;
+	s->id = candidate->id;
+	s->size = candidate->size;
+	s->unif_buf_size = candidate->unif_buf_size;
+	s->mat = candidate->mat;
+	s->unif_blk = candidate->unif_blk;
+}
