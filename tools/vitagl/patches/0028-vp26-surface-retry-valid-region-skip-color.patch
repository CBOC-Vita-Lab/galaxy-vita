+GLboolean vglSetNextSceneValidRegion(GLint xMax, GLint yMax) {
+	vgl_vr_fb = NULL;
+	framebuffer *fb = active_write_fb;
+	if (vgl_vr_broken || !fb || xMax < 0 || yMax < 0)
+		return GL_FALSE;
+	xMax |= 31;
+	yMax |= 31;
+	if (xMax >= (GLint)fb->width) xMax = fb->width - 1;
+	if (yMax >= (GLint)fb->height) yMax = fb->height - 1;
+	if (xMax == (GLint)fb->width - 1 && yMax == (GLint)fb->height - 1)
+		return GL_FALSE; // (the whole target: nothing to gain)
+	vgl_vr.xMax = xMax;
+	vgl_vr.yMax = yMax;
+	vgl_vr_fb = fb;
+	return GL_TRUE;
+}
