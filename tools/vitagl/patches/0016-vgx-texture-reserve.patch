+// (Galaxy port, patch 0015) vglReserveTextureLevels: the one-shot hint for the next level-0 allocation of that size.
+static uint32_t vgl_reserve_w = 0, vgl_reserve_h = 0;
+static int32_t vgl_reserve_levels = 0;
+void vglReserveTextureLevels(GLsizei width, GLsizei height, GLint levels) {
+	vgl_reserve_w = width;
+	vgl_reserve_h = height;
+	vgl_reserve_levels = levels;
+}
+// The hint's levels for a level-0 allocation of w x h (0: none), cleared in any case.
+static int32_t vgl_take_reserve(uint32_t w, uint32_t h) {
+	const int32_t levels = (vgl_reserve_w == w && vgl_reserve_h == h) ? vgl_reserve_levels : 0;
+	vgl_reserve_levels = 0;
+	return levels;
+}
+// The bytes gpu_alloc_mipmaps(-1, ...) reallocates a w x h linear texture to (the same arithmetic).
+static uint32_t vgl_linear_chain_size(uint32_t orig_w, uint32_t orig_h, uint32_t bpp) {
+	uint32_t w = nearest_po2(orig_w), h = nearest_po2(orig_h), size = 0;
+	while ((w > 1) && (h > 1)) {
+		size += MAX(w, 8) * h * bpp;
+		w /= 2;
+		h /= 2;
+	}
+	size += MAX(w, 8) * h * bpp;
+	return size;
+}
