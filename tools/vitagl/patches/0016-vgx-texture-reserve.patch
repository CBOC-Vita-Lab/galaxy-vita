+// (patch 0015) glGenTextures' walk starts at the lowest slot that may be free: a slot made free lowers it.
+extern GLuint vgl_tex_first_free;
+extern texture texture_slots[];
+static inline __attribute__((always_inline)) void vgl_tex_slot_freed(GLuint i) {
+	if (i >= 1 && i < vgl_tex_first_free)
+		vgl_tex_first_free = i;
+}
+
 // Dealloc a texture
 static inline __attribute__((always_inline)) void gpu_free_texture(texture *tex) {
 	gpu_free_texture_data(tex);
 	tex->status = TEX_UNUSED;
+	if (tex >= &texture_slots[0] && tex < &texture_slots[TEXTURES_NUM])
+		vgl_tex_slot_freed((GLuint)(tex - &texture_slots[0]));
 }
 
