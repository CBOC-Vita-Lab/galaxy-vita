+}
+
+// The exact free figure of every pool again, the tracking from now on.
+void vglMemFreeFastResync(void) {
+	for (int t = 0; t < VGL_MEM_EXTERNAL; t++) {
+		__atomic_store_n(&s24_delta[t], 0, __ATOMIC_RELAXED);
+		s24_base[t] = vgl_mem_get_free_space(t);
+	}
+	s24_track = GL_TRUE;
+}
+
+size_t vglMemFreeFast(vglMemType type) {
+	if (type >= VGL_MEM_EXTERNAL)
+		return vgl_mem_get_free_space(type);
+	if (!s24_track)
+		vglMemFreeFastResync();
+	const int64_t v = (int64_t)s24_base[type] - (int64_t)__atomic_load_n(&s24_delta[type], __ATOMIC_RELAXED);
+	return v > 0 ? (size_t)v : 0;
+}
+
+// One pool's statistics both ways, timed (a diagnostic for the host's profile line): out[0..3] sceClibMspaceMallocStats (capacity,
+// unk, peak_in_use, current_in_use), out[4] its us, out[5..8] sceClibMspaceMallocStatsFast, out[9] its us, out[10] vglMemFreeFast's
+// figure (0 before the tracking started), out[11] 1 when the tracking runs. All 0 for a pool without an mspace.
+void vglMemStatsProbe(vglMemType type, uint32_t *out) {
+	for (int i = 0; i < 12; i++)
+		out[i] = 0;
+#ifndef HAVE_CUSTOM_HEAP
+	if (type >= VGL_MEM_EXTERNAL || !mempool_mspace[type])
+		return;
+	SceClibMspaceStats a, b;
+	uint32_t t0 = vgl_s24_now();
+	sceClibMspaceMallocStats(mempool_mspace[type], &a);
+	uint32_t t1 = vgl_s24_now();
+	sceClibMspaceMallocStatsFast(mempool_mspace[type], &b);
+	uint32_t t2 = vgl_s24_now();
+	out[0] = a.capacity; out[1] = a.unk; out[2] = a.peak_in_use; out[3] = a.current_in_use; out[4] = t1 - t0;
+	out[5] = b.capacity; out[6] = b.unk; out[7] = b.peak_in_use; out[8] = b.current_in_use; out[9] = t2 - t1;
+	if (s24_track) {
+		const int64_t v = (int64_t)s24_base[type] - (int64_t)__atomic_load_n(&s24_delta[type], __ATOMIC_RELAXED);
+		out[10] = v > 0 ? (uint32_t)v : 0;
+		out[11] = 1;
+	}
+#endif
+}
+
+void vglGetSlowStats(uint32_t *out, uint32_t n) {
+	vgl_s24[VGL_S24_PURGE_FILL] = frame_elem_purge_idx;
+	vgl_s24[VGL_S24_RT_PURGE_FILL] = frame_rt_purge_idx;
+	vgl_s24[VGL_S24_TEX_FIRST_FREE] = vgl_tex_first_free;
+	vgl_s24[VGL_S24_FB_ACTIVE] = vgl_s24_fb_active();
+	for (uint32_t i = 0; i < n; i++)
+		out[i] = i < VGL_S24_COUNT ? vgl_s24[i] : 0;
+}
+#endif
