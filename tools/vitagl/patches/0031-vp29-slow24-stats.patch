+
+void *vgl_realloc(void *ptr, size_t size) {
+	if (!ptr || !s24_track)
+		return vgl_realloc_s24(ptr, size);
+	// (the old block's bytes leave the tracked figure, the new block's come in; a failed realloc keeps the old block)
+	const vglMemType type = vgl_mem_get_type_by_addr(ptr);
+	const size_t old_size = (unsigned)type < VGL_MEM_EXTERNAL ? vgl_malloc_usable_size(ptr) : 0;
+	void *res = vgl_realloc_s24(ptr, size);
+	if (res && (unsigned)type < VGL_MEM_EXTERNAL) {
+		const vglMemType new_type = vgl_mem_get_type_by_addr(res);
+		__atomic_fetch_sub(&s24_delta[type], (int32_t)old_size, __ATOMIC_RELAXED);
+		if ((unsigned)new_type < VGL_MEM_EXTERNAL)
+			__atomic_fetch_add(&s24_delta[new_type], (int32_t)vgl_malloc_usable_size(res), __ATOMIC_RELAXED);
+	}
