+	VGL_S24_SCENE_N, VGL_S24_SCENE_US,           // scene_reset calls that changed the scene (end + begin + what they need)
+	VGL_S24_END_N, VGL_S24_END_US,               // the sceGxmEndScene of those
+	VGL_S24_BEGIN_N, VGL_S24_BEGIN_US,           // the begin part (depth buffer, render target, sceGxmBeginScene)
+	VGL_S24_DEPTH_N, VGL_S24_DEPTH_US,           // depth/stencil buffers made for a framebuffer object's scene (in the begin part)
+	VGL_S24_MEM0,                                // per pool type t (VRAM, RAM, PHYCONT, BUDGET): 5 slots from VGL_S24_MEM0 + 5 * t:
+	                                             // allocations, their us, frees, their us, failed allocations (next pool tried)
+	VGL_S24_EXT_ALLOC_N = VGL_S24_MEM0 + 20,     // allocations from the C heap (every pool full)
+	VGL_S24_MEMFREE_N, VGL_S24_MEMFREE_US,       // vglMemFree / vgl_mem_get_free_space calls (sceClibMspaceMallocStats) and their us
+	VGL_S24_GENTEX_N, VGL_S24_GENTEX_WALK,       // glGenTextures names handed out, texture slots read to find them
+	VGL_S24_DELTEX_N,                            // glDeleteTextures names
+	VGL_S24_TEXIMG_N, VGL_S24_TEXIMG_NULL_N,     // glTexImage2D calls, of them with no data (storage only)
+	VGL_S24_ATTACH_N, VGL_S24_RT_DIRTY_N,        // colour attachments made (_glFramebufferTexture2D), render targets given up by them
+	VGL_S24_PURGE_FILL, VGL_S24_RT_PURGE_FILL,   // (now) entries in the collector's list being filled
+	VGL_S24_TEX_FIRST_FREE,                      // (now) glGenTextures' first slot that may be free
+	VGL_S24_FB_ACTIVE,                           // (now) framebuffer objects in use (of 256)
+	VGL_S24_GC_N, VGL_S24_GC_US, VGL_S24_GC_FREED, // collector cycles, their us (collector thread), blocks and targets they freed
+	VGL_S24_LIVE0,                               // per pool type: blocks allocated minus freed since the tracking started (4 slots)
+	VGL_S24_COUNT = VGL_S24_LIVE0 + 4
+};
+extern volatile uint32_t vgl_s24[VGL_S24_COUNT];
+extern GLboolean vgl_s24_on;
+uint32_t vgl_s24_fb_active(void); // (framebuffers.c)
+static inline __attribute__((always_inline)) uint32_t vgl_s24_now(void) { return sceKernelGetProcessTimeLow(); }
+static inline __attribute__((always_inline)) void vgl_s24_add(int slot, uint32_t v) { __atomic_fetch_add(&vgl_s24[slot], v, __ATOMIC_RELAXED); }
+#endif
