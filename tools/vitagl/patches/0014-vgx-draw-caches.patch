+// ---- vgx draw caches (vglSetDrawCaches; all off unless the caller turns them on: stock behaviour)
+// VGL_DRAWCACHE_FRAGMEMO: setup_frag_program asks sceGxmShaderPatcherCreateFragmentProgram for a new patched fragment program
+// every time a program is drawn with another blend info / target format / multisample mode than its last draw (a program used
+// alternately with two blends, or in the EFB and in a texture pass, pays the patcher's lookup on every switch). The patcher
+// returns the same object for the same arguments (it is reference counted and vitaGL never releases these), so each program
+// remembers the last VGL_FRAG_MEMO it was given, by (blend info, mode), and takes one from there; the patcher is asked only for
+// a combination the program has not kept. The memo is emptied when the program is created or linked (as direct_vprog).
+// VGL_DRAWCACHE_UNIREUSE: upload_uniforms reserves a new piece of the uniform ring and copies the program's whole default uniform
+// buffer into it whenever the dirty flag is set, and glUseProgram sets it on every program switch, so a program drawn again with
+// unchanged values (A, B, A) copies its whole buffer again. The ring is only written at reservations and a piece is never
+// written again before the pool rolls over (gxm_utils.c; with UNIFORM_PINGPONG the other arena is only written at the next
+// rollover), so the piece the program's last upload made still holds exactly its values until (1) one of its uniforms is
+// written (vgl_note_unif_write: the program's own copy is forgotten; a write that cannot be placed in the current program's
+// buffers forgets every program's copies), or (2) the pool rolls over (vgl_unif_pool_gen). Until then the program's default
+// uniform buffer is pointed at that piece again (sceGxmSet*DefaultUniformBuffer, and vgl_def_*_buf, so a rollover and the
+// internal clears and blits restore it as before) instead of being copied. Not with HAVE_GLSL_TEXTURE_SIZE (draws write the
+// texture sizes into the fragment buffer) nor the fixed-function uniform path.
+static uint32_t vgl_drawcache_flags = 0;
+static uint32_t vgl_unif_epoch = 1;
+static uint32_t vgl_dc_stats[8] = {0}; // patched, memo hits, vertex copies, vertex re-uses, fragment copies, fragment re-uses, vertex bytes, fragment bytes
+
+void vglSetDrawCaches(uint32_t flags) {
+#if defined(HAVE_GLSL_TEXTURE_SIZE) || defined(HAVE_FFP_SHADER_SUPPORT)
+	flags &= ~VGL_DRAWCACHE_UNIREUSE;
+#endif
+	if ((flags & VGL_DRAWCACHE_UNIREUSE) && !(vgl_drawcache_flags & VGL_DRAWCACHE_UNIREUSE))
+		vgl_unif_epoch++; // (copies made while it was off are not trusted)
+	vgl_drawcache_flags = flags;
+}
+
+void vglGetDrawCacheStats(uint32_t *stats) {
+	for (int i = 0; i < 8; i++)
+		stats[i] = vgl_dc_stats[i];
+}
+
+static inline __attribute__((always_inline)) void vgl_reset_draw_caches(program *p) {
+	vgl_memset(p->frag_memo_prog, 0, sizeof(p->frag_memo_prog));
+	p->frag_memo_next = 0;
+	p->ring_v = p->ring_f = NULL;
+	p->ring_gen_v = p->ring_gen_f = 0;
+}
+
+static inline __attribute__((always_inline)) void vgl_patch_frag_program(program *p, SceGxmOutputRegisterFormat fmt) {
+	if (!(vgl_drawcache_flags & VGL_DRAWCACHE_FRAGMEMO)) {
+		rebuild_frag_shader(p->fshader->id, &p->fprog, (SceGxmProgram *)p->vshader->prog, fmt);
+		vgl_dc_stats[0]++;
+		return;
+	}
+	uint8_t mode = fmt == SCE_GXM_OUTPUT_REGISTER_FORMAT_HALF4 ? 1 : 0;
+#ifdef FBO_MSAA
+	mode |= (uint8_t)(cur_msaa << 1);
+#else
+	mode |= (uint8_t)(msaa_mode << 1);
+#endif
+	for (int k = 0; k < VGL_FRAG_MEMO; k++) {
+		if (p->frag_memo_prog[k] && p->frag_memo_blend[k] == blend_info.raw && p->frag_memo_mode[k] == mode) {
+			p->fprog = p->frag_memo_prog[k];
+			vgl_dc_stats[1]++;
+			return;
+		}
+	}
+	SceGxmFragmentProgram *fp = NULL;
+	rebuild_frag_shader(p->fshader->id, &fp, (SceGxmProgram *)p->vshader->prog, fmt);
+	vgl_dc_stats[0]++;
+	if (!fp)
+		return; // (patching failed, already logged: the program keeps the fragment program it had, nothing is remembered)
+	p->fprog = fp;
+	const uint8_t k = p->frag_memo_next;
+	p->frag_memo_blend[k] = blend_info.raw;
+	p->frag_memo_mode[k] = mode;
+	p->frag_memo_prog[k] = fp;
+	p->frag_memo_next = (k + 1) % VGL_FRAG_MEMO;
+}
+
+// A uniform write (vgl_fill_uniform_data) to the data at vptr / fptr: the ring copies that no longer hold the program's values.
+static inline __attribute__((always_inline)) void vgl_note_unif_write(const void *vptr, const void *fptr) {
+	program *cp = cur_program ? &progs[cur_program - 1] : NULL;
+	if (cp) {
+		const uint8_t *vb = (const uint8_t *)cp->unif_vbuffer, *fb = (const uint8_t *)cp->unif_fbuffer;
+		const GLboolean v_ok = !vptr || (vb && (const uint8_t *)vptr >= vb && (const uint8_t *)vptr < vb + cp->vshader->unif_buf_size);
+		const GLboolean f_ok = !fptr || (fb && (const uint8_t *)fptr >= fb && (const uint8_t *)fptr < fb + cp->fshader->unif_buf_size);
+		if (v_ok && f_ok) {
+			if (vptr)
+				cp->ring_gen_v = 0;
+			if (fptr)
+				cp->ring_gen_f = 0;
+			return;
+		}
+	}
+	vgl_unif_epoch++; // (a uniform of another program: every program's copies are forgotten)
+}
+
+static inline __attribute__((always_inline)) void vgl_upload_vert_unifs(program *p) {
+	const uint32_t size = p->vshader->unif_buf_size;
+	if ((vgl_drawcache_flags & VGL_DRAWCACHE_UNIREUSE) && p->ring_v && p->ring_gen_v == vgl_unif_pool_gen && p->ring_epoch_v == vgl_unif_epoch) {
+		vgl_def_vert_buf = p->ring_v;
+		vgl_def_vert_buf_size = size;
+		sceGxmSetVertexDefaultUniformBuffer(gxm_context, p->ring_v);
+		vgl_dc_stats[3]++;
+		return;
+	}
+	void *buffer = vglReserveVertexUniformBuffer(size);
+	vgl_fast_memcpy(buffer, p->unif_vbuffer, size);
+	p->ring_v = buffer;
+	p->ring_gen_v = vgl_unif_pool_gen; // (read after the reservation: a rollover inside it has already counted)
+	p->ring_epoch_v = vgl_unif_epoch;
+	vgl_dc_stats[2]++;
+	vgl_dc_stats[6] += size;
+}
+
+static inline __attribute__((always_inline)) void vgl_upload_frag_unifs(program *p) {
+	const uint32_t size = p->fshader->unif_buf_size;
+	if ((vgl_drawcache_flags & VGL_DRAWCACHE_UNIREUSE) && p->ring_f && p->ring_gen_f == vgl_unif_pool_gen && p->ring_epoch_f == vgl_unif_epoch) {
+		vgl_def_frag_buf = p->ring_f;
+		vgl_def_frag_buf_size = size;
+		sceGxmSetFragmentDefaultUniformBuffer(gxm_context, p->ring_f);
+		vgl_dc_stats[5]++;
+		return;
+	}
+	void *buffer = vglReserveFragmentUniformBuffer(size);
+	vgl_fast_memcpy(buffer, p->unif_fbuffer, size);
+	p->ring_f = buffer;
+	p->ring_gen_f = vgl_unif_pool_gen;
+	p->ring_epoch_f = vgl_unif_epoch;
+	vgl_dc_stats[4]++;
+	vgl_dc_stats[7] += size;
+}
+
