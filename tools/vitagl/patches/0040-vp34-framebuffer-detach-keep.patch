+			else if (sceGxmColorSurfaceGetData(&active_write_fb->colorbuffer) != active_write_fb->tex->data) {
 				_glFramebufferTexture2D(active_write_fb, GL_COLOR_ATTACHMENT0, active_write_fb->tex, 1);
 			}
 			
diff --git a/source/shared.h b/source/shared.h
index 1de0243..8056b21 100644
--- a/source/shared.h
+++ b/source/shared.h
@@ -1363,6 +1363,7 @@ static inline __attribute__((always_inline)) uint32_t get_color_from_texture(Sce
 	}
 }
 
+extern GLboolean vgl_fb_detach_keep; // patch 0040 (framebuffers.c): detaching the colour texture (id 0) keeps the object's size, render target and depth surface
 static inline __attribute__((always_inline)) void _glFramebufferTexture2D(framebuffer *fb, GLenum attachment, texture *tex, GLuint tex_id) {
 	// Extracting texture data
 	int old_w = fb->width, old_h = fb->height;
@@ -1371,6 +1372,21 @@ static inline __attribute__((always_inline)) void _glFramebufferTexture2D(frameb
 	// Detecting requested attachment
 	switch (attachment) {
 	case GL_COLOR_ATTACHMENT0:
+		// patch 0040: detaching (texture id 0) used to read the sizes of texture slot 0 into fb->width / fb->height BEFORE looking at tex_id and drop the render target at once.
+		// With vgl_fb_detach_keep the detach only releases the texture: width, height, target and depth surface stay for a later attach of the same size.
+		if (tex_id == 0 && vgl_fb_detach_keep) {
+			if (fb->tex) {
+				fb->tex->ref_counter--;
+				if (fb->tex->dirty && fb->tex->ref_counter == 0) {
+					gpu_free_texture(fb->tex);
+				}
+			}
+			fb->tex = NULL;
+			fb->data = NULL;
+			if (in_use_framebuffer == fb)
+				dirty_framebuffer = GL_TRUE;
+			return;
+		}
 		vglGetTexSizes(&tex->gxm_tex, &fb->width, &fb->height);
 		fb->stride = VGL_ALIGN(fb->width, 8) * tex_format_to_bytespp(fmt);
 		fb->data = vglGetTexData(&tex->gxm_tex);
