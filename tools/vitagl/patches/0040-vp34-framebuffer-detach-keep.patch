Patch 0040 (vp34, ported from Strikers 0062 + Carbon S4, GXV_VGL_FBO_KEEP): glFramebufferTexture2D(GL_COLOR_ATTACHMENT0, 0) keeps the framebuffer object's width, height, render target and depth surface while clearing fb->tex and fb->data; gxm.c scene_reset and *ReadPixels refuse a detached FBO cleanly.
diff --git a/source/framebuffers.c b/source/framebuffers.c
index 0417665..544a5b8 100644
--- a/source/framebuffers.c
+++ b/source/framebuffers.c
@@ -198,6 +198,15 @@ GLboolean _glReadPixels_gpu(GLint x, GLint y, GLsizei width, GLsizei height, GLe
  * ------------------------------
  */
 
+// patch 0040 (GXV_VGL_FBO_KEEP): see _glFramebufferTexture2D (shared.h). Default off: detach drops render target as before.
+GLboolean vgl_fb_detach_keep = GL_FALSE;
+void vglSetFramebufferDetachKeep(GLboolean on) {
+	vgl_fb_detach_keep = on ? GL_TRUE : GL_FALSE;
+}
+GLboolean vglGetFramebufferDetachKeep(void) {
+	return vgl_fb_detach_keep;
+}
+
 inline __attribute__((always_inline)) void glGenFramebuffers(GLsizei n, GLuint *ids) {
 	THREAD_SAFE()
 
@@ -585,6 +594,10 @@ void glGetFramebufferAttachmentParameteriv(GLenum target, GLenum attachment, GLe
 void glReadPixels(GLint x, GLint y, GLsizei width, GLsizei height, GLenum format, GLenum type, GLvoid *data) {
 	THREAD_SAFE()
 
+	// patch 0040: detached FBO has no colour texture/data
+	if (active_read_fb && (!active_read_fb->tex || !active_read_fb->data))
+		return;
+
 	/*
 	 * Callbacks are actually used to just perform down/up-sampling
 	 * between U8 texture formats. Reads are expected to give as result
@@ -804,6 +817,9 @@ void glReadPixels(GLint x, GLint y, GLsizei width, GLsizei height, GLenum format
 void vglReadPixels(GLint x, GLint y, GLsizei width, GLsizei height, GLenum format, GLenum type, GLvoid *data) {
 	THREAD_SAFE()
 
+	if (active_read_fb && (!active_read_fb->tex || !active_read_fb->data)) // patch 0040
+		return;
+
 	GLboolean res = _glReadPixels_gpu(x, y, width, height, format, type, data, GL_TRUE);
 #ifndef SKIP_ERROR_HANDLING
 	if (!res) {
diff --git a/source/gxm.c b/source/gxm.c
index 8d44fc0..c8900f9 100644
--- a/source/gxm.c
+++ b/source/gxm.c
@@ -817,8 +817,13 @@ GLboolean scene_reset(void) {
 			if (r)
