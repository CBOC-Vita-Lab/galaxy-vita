 #endif
 
+// patch 0041 (GXV_VGL_WRCOPY / GXV_VGL_TEXCOPY_DMA): write-combining NEON/DMA copies into uncached pools and texture memory (utils/wrcopy.c)
+void vgl_wr_copy(void *dst, const void *src, uint32_t n);
+void vgl_tex_copy(void *dst, const void *src, uint32_t n);
+
