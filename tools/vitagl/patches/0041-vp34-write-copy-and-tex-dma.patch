diff --git a/source/utils/wrcopy.c b/source/utils/wrcopy.c
new file mode 100644
index 0000000..1f84e97
--- /dev/null
+++ b/source/utils/wrcopy.c
@@ -0,0 +1,180 @@
+/*
+ * wrcopy.c (patch 0041, ported from Strikers 0045 + 0051 + 0061 + Carbon S7):
+ *  - vgl_wr_copy: NEON 64B / vstm 128B / DMA copies into uncached pools (stream buffers, uniform ring) with mode 3 -> mode 1 NEON fallback.
+ *  - vgl_tex_copy: DMA engine contiguous linear texture upload copy (8 KiB+, full span strictly below 0x81000000).
+ */
+#include <stdint.h>
+#include <string.h>
+#include <psp2/kernel/clib.h>
+#include <psp2/kernel/dmac.h>
+#include <psp2/kernel/processmgr.h>
+#include "wrcopy.h"
+#ifndef vgl_fast_memcpy
+#define vgl_fast_memcpy sceClibMemcpy
+#endif
+
+#define VGL_WRCOPY_MIN 192u
+#define VGL_DMA_ADDR_LIMIT 0x81000000u
+#ifndef VGL_WR_ADDR
+#define VGL_WR_ADDR(p) ((uint32_t)(uintptr_t)(p))
+#endif
+#define VGL_DMA_SPAN_OK(p, n) ((n) <= VGL_DMA_ADDR_LIMIT && VGL_WR_ADDR(p) <= VGL_DMA_ADDR_LIMIT - (n))
+
+static volatile int vgl_wr_mode = 0;
+static volatile int vgl_wr_fb = 1; // mode 3 fallback: 1 = mode 1 NEON stores (default), 0 = sceClibMemcpy
+uint32_t vgl_wr_stat[8];           // [0..1] NEON copies/bytes, [2..3] clib copies/bytes, [4..5] DMA copies/bytes, [6] 8KiB+ >=0x81000000 skips, [7] DMA errors
+
+static inline void wr_neon64(uint8_t *d, const uint8_t *s, uint32_t blocks) {
+	__asm__ volatile(
+		"1:\n\t"
+		"pld [%1, #256]\n\t"
+		"vld1.8 {d0-d3}, [%1]!\n\t"
+		"vld1.8 {d4-d7}, [%1]!\n\t"
+		"subs %2, %2, #1\n\t"
+		"vst1.64 {d0-d3}, [%0:256]!\n\t"
+		"vst1.64 {d4-d7}, [%0:256]!\n\t"
+		"bne 1b\n\t"
+		: "+r"(d), "+r"(s), "+r"(blocks)
+		:
+		: "d0", "d1", "d2", "d3", "d4", "d5", "d6", "d7", "memory", "cc");
+}
+
+static inline void wr_vstm128(uint8_t *d, const uint8_t *s, uint32_t blocks) {
+	__asm__ volatile(
+		"1:\n\t"
+		"pld [%1, #256]\n\t"
+		"vld1.8 {d0-d3}, [%1]!\n\t"
+		"vld1.8 {d4-d7}, [%1]!\n\t"
+		"vld1.8 {d8-d11}, [%1]!\n\t"
+		"vld1.8 {d12-d15}, [%1]!\n\t"
+		"subs %2, %2, #1\n\t"
+		"vstmia %0!, {d0-d15}\n\t"
+		"bne 1b\n\t"
+		: "+r"(d), "+r"(s), "+r"(blocks)
+		:
+		: "d0", "d1", "d2", "d3", "d4", "d5", "d6", "d7", "d8", "d9", "d10", "d11", "d12", "d13", "d14", "d15", "memory", "cc");
+}
+
+void vglSetWriteCopyFallback(int on) {
+	vgl_wr_fb = on ? 1 : 0;
+}
+int vglGetWriteCopyFallback(void) {
+	return vgl_wr_fb;
+}
+
+void vglWriteCopyVariant(int mode, void *dst, const void *src, uint32_t n) {
+	uint8_t *d = (uint8_t *)dst;
+	const uint8_t *s = (const uint8_t *)src;
+	if (mode == 3) {
+		if (n >= 0x2000u) {
+			if (VGL_DMA_SPAN_OK(s, n) && VGL_DMA_SPAN_OK(d, n)) {
+				if (sceDmacMemcpy(d, s, n) >= 0) {
+					vgl_wr_stat[4]++;
+					vgl_wr_stat[5] += n;
+					return;
+				}
+				vgl_wr_stat[7]++;
+			} else {
+				vgl_wr_stat[6]++;
+			}
+		}
+		if (!vgl_wr_fb) {
+			vgl_wr_stat[2]++;
+			vgl_wr_stat[3] += n;
+			sceClibMemcpy(d, s, n);
+			return;
+		}
+		mode = 1;
+	}
+	if (mode != 1 && mode != 2) {
+		vgl_wr_stat[2]++;
+		vgl_wr_stat[3] += n;
+		sceClibMemcpy(d, s, n);
+		return;
+	}
+	const uint32_t unit = mode == 1 ? 64u : 128u;
+	uint32_t head = (uint32_t)(-(intptr_t)d) & 63u;
+	if (n < head + unit) {
+		vgl_wr_stat[2]++;
+		vgl_wr_stat[3] += n;
+		sceClibMemcpy(d, s, n);
+		return;
+	}
+	vgl_wr_stat[0]++;
+	vgl_wr_stat[1] += n;
+	if (head) {
+		sceClibMemcpy(d, s, head);
+		d += head;
+		s += head;
+		n -= head;
+	}
+	const uint32_t blocks = n >> (mode == 1 ? 6 : 7);
+	if (mode == 1)
+		wr_neon64(d, s, blocks);
+	else
+		wr_vstm128(d, s, blocks);
+	d += blocks * unit;
+	s += blocks * unit;
+	n -= blocks * unit;
+	if (n)
+		sceClibMemcpy(d, s, n);
+}
+
+void vglSetWriteCopy(int mode) {
+	vgl_wr_mode = (mode >= 1 && mode <= 3) ? mode : 0;
+}
+int vglGetWriteCopy(void) {
+	return vgl_wr_mode;
+}
+void vglWriteCopyStats(uint32_t *out4) {
+	for (int i = 0; i < 4; i++)
+		out4[i] = vgl_wr_stat[i];
+}
+void vglWriteCopyStats8(uint32_t *out8) {
+	for (int i = 0; i < 8; i++)
+		out8[i] = vgl_wr_stat[i];
+}
+
+static volatile int vgl_tex_mode = 0;
+static uint32_t vgl_tex_stat[6]; // dma copies, dma bytes, dma us, cpu copies, differences (mode 2), refusals
+void vglSetTextureCopyDma(int mode) {
+	vgl_tex_mode = (mode == 1 || mode == 2) ? mode : 0;
+}
+void vglTextureCopyStats(uint32_t *out6) {
+	for (int i = 0; i < 6; i++)
+		out6[i] = vgl_tex_stat[i];
+}
+void vgl_tex_copy(void *dst, const void *src, uint32_t n) {
+	const int m = vgl_tex_mode;
+	if (m == 0) {
+		vgl_fast_memcpy(dst, src, n);
+		return;
+	}
+	if (n >= 0x2000u && VGL_DMA_SPAN_OK(src, n) && VGL_DMA_SPAN_OK(dst, n)) {
+		const uint64_t t0 = sceKernelGetProcessTimeWide();
+		if (sceDmacMemcpy(dst, src, n) >= 0) {
+			vgl_tex_stat[0]++;
+			vgl_tex_stat[1] += n;
+			vgl_tex_stat[2] += (uint32_t)(sceKernelGetProcessTimeWide() - t0);
+			if (m == 2 && memcmp(dst, src, n) != 0) {
+				vgl_tex_stat[4]++;
+				sceClibMemcpy(dst, src, n);
+			}
+			return;
+		}
+		vgl_tex_stat[5]++;
+	}
+	vgl_tex_stat[3]++;
+	vgl_fast_memcpy(dst, src, n);
+}
+
+void vgl_wr_copy(void *dst, const void *src, uint32_t n) {
+	const int m = vgl_wr_mode;
+	if (m == 0 || n < VGL_WRCOPY_MIN) {
+		vgl_wr_stat[2]++;
+		vgl_wr_stat[3] += n;
+		sceClibMemcpy(dst, src, n);
+		return;
+	}
+	vglWriteCopyVariant(m, dst, src, n);
+}
