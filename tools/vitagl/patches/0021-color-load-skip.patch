+// COLOR_LOAD_FROM, patch 0021: vglColorLoadSkip(GL_TRUE) arms the next scene begun on the bound draw framebuffer (or on the display when
+// none is bound: framebuffer 0) to make a CHEAP colour load. Its colour is then not the surface's old content: GXM's tile load reads
+// the background texture, and for that scene the texture is a 32x32 swizzled REPEAT texture of the same format, so every tile is
+// filled from the same 4 KiB (resident in the texture cache) instead of from 2.1 MB (960x544) / 1.2 MB (720x404) of memory.
+// The host arms it only for a scene whose first drawing writes all four channels of every pixel before anything reads them
+// (a full-target colour+alpha clear, a first draw that covers everything unblended): what the load would have brought is then
+// never seen. Everything else about the scene (the store, the depth modes, the viewport) is untouched. One scene begin only
+// (scene_reset's); a begin on another framebuffer drops it, and so does vglColorLoadSkip(GL_FALSE), which the host calls right after
+// the clear that began the scene. Counter: vglGetColorLoadSkips().
+static framebuffer *vgl_color_skip_fb = NULL;
+static GLboolean vgl_color_skip_armed = GL_FALSE;
+static uint32_t vgl_color_load_skips = 0;
+static void *vgl_color_skip_data = NULL;
+static SceGxmColorSurface vgl_color_skip_display_saved;
+static int vgl_color_skip_display_idx = -1;
+uint32_t vglGetColorLoadSkips(void) { return vgl_color_load_skips; }
+GLboolean vglColorLoadSkip(GLboolean arm) {
+	vgl_color_skip_armed = GL_FALSE;
+	vgl_color_skip_fb = NULL;
+	if (!arm)
+		return GL_TRUE; // (disarmed: the host calls it after the clear that began the scene, so a begin that did not happen leaves nothing behind)
+	if (msaa_mode != SCE_GXM_MULTISAMPLE_NONE)
+		return GL_FALSE;
+	if (active_write_fb && !active_write_fb->tex)
+		return GL_FALSE;
+	if (!vgl_color_skip_data) {
+		vgl_color_skip_data = gpu_alloc_mapped_aligned_for_gpu(SCE_GXM_TEXTURE_ALIGNMENT, 4096);
+		if (!vgl_color_skip_data)
+			return GL_FALSE;
+		vgl_memset(vgl_color_skip_data, 0, 4096);
+	}
+	vgl_color_skip_armed = GL_TRUE;
+	vgl_color_skip_fb = active_write_fb;
+	return GL_TRUE;
+}
+// The background texture of `surface` made cheap (32x32, 4 bytes a pixel at most: the data is 4096 bytes).
+static GLboolean vgl_color_skip_apply(SceGxmColorSurface *surface) {
+	SceGxmTextureFormat fmt = sceGxmTextureGetFormat(&surface->backgroundTex);
+	SceGxmTexture t;
+	if (sceGxmTextureInitSwizzled(&t, vgl_color_skip_data, fmt, 32, 32, 1) != 0)
+		return GL_FALSE;
+	sceGxmTextureSetUAddrMode(&t, SCE_GXM_TEXTURE_ADDR_REPEAT);
+	sceGxmTextureSetVAddrMode(&t, SCE_GXM_TEXTURE_ADDR_REPEAT);
+	sceGxmTextureSetMinFilter(&t, SCE_GXM_TEXTURE_FILTER_POINT);
+	sceGxmTextureSetMagFilter(&t, SCE_GXM_TEXTURE_FILTER_POINT);
+	surface->backgroundTex = t;
+	return GL_TRUE;
+}
+// The display's surfaces are changed in place (the begin of the display scene is build-vitagl.sh's text and takes the array
+// element): the element is put back at the next scene_reset, before the next scene begins.
+static void vgl_color_skip_display_restore(void) {
+	if (vgl_color_skip_display_idx >= 0) {
+		gxm_color_surfaces[vgl_color_skip_display_idx] = vgl_color_skip_display_saved;
+		vgl_color_skip_display_idx = -1;
+	}
+}
+static void vgl_color_skip_display_begin(void) {
+	if (!vgl_color_skip_armed || vgl_color_skip_fb != NULL) {
+		if (vgl_color_skip_armed)
+			vgl_color_skip_armed = GL_FALSE; // (armed for a framebuffer object, a begin on the display drops it)
+		return;
+	}
+	vgl_color_skip_armed = GL_FALSE;
+	int idx = gxm_back_buffer_index;
+	vgl_color_skip_display_saved = gxm_color_surfaces[idx];
+	if (vgl_color_skip_apply(&gxm_color_surfaces[idx])) {
+		vgl_color_skip_display_idx = idx;
+		vgl_color_load_skips++;
+	} else {
+		gxm_color_surfaces[idx] = vgl_color_skip_display_saved;
+	}
+}
 static SceGxmColorSurface *vgl_color_load(framebuffer *fb) {
 	static SceGxmColorSurface surface; // (alive until the scene ends: the next arming comes after it)
+	if (vgl_color_skip_armed) {
+		GLboolean mine = vgl_color_skip_fb == fb;
+		vgl_color_skip_armed = GL_FALSE;
+		vgl_color_skip_fb = NULL;
+		if (mine && !(vgl_color_load_src && vgl_color_load_fb == fb)) { // (a load from another buffer is a load that is needed)
+			surface = fb->colorbuffer;
+			if (vgl_color_skip_apply(&surface)) {
+				vgl_color_load_fb = NULL;
+				vgl_color_load_src = NULL;
+				vgl_color_load_skips++;
+				return &surface;
+			}
+		}
+	}
 	if (!vgl_color_load_src || vgl_color_load_fb != fb) {
 		vgl_color_load_fb = NULL;
 		vgl_color_load_src = NULL;
@@ -784,8 +870,12 @@ static SceGxmColorSurface *vgl_color_load(framebuffer *fb) {
 	return &surface;
 }
 #define VGL_COLOR_LOAD(fb) vgl_color_load(fb)
+#define VGL_COLOR_SKIP_DISPLAY_RESTORE() vgl_color_skip_display_restore()
+#define VGL_COLOR_SKIP_DISPLAY_BEGIN() vgl_color_skip_display_begin()
 #else
 #define VGL_COLOR_LOAD(fb) (&(fb)->colorbuffer)
+#define VGL_COLOR_SKIP_DISPLAY_RESTORE()
+#define VGL_COLOR_SKIP_DISPLAY_BEGIN()
 #endif
 
