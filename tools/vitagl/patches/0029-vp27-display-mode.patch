+#ifdef VP27_DISPLAY_MODE
+// ---- Patch 0029 (VP27_DISPLAY_MODE): the display mode changes between pictures, without sceGxmFinish and without new memory ----
+// The display buffers are allocated once, for the size vitaGL was started with (960x544: 3 x 3 MiB). A smaller sceDisplay mode (480x272,
+// 640x368, 720x408: the display controller scales it to the panel, bilinear on the 0x18-byte frame buffer structure) needs less of the
+// same memory: the colour surfaces are described again over it (width, height, stride = align(width, 64), as vglInitWithCustomSizes
+// would for that size), the display scene uses a render target of that size (made by vglPrepareDisplayMode, kept), and each queued flip
+// carries its own width/height/pitch to the display callback. DISPLAY_WIDTH/HEIGHT/STRIDE (and so glViewport's flip, scissors, blits and
+// reads of the default framebuffer) follow the current mode. The depth/stencil surface is left as it is (the render target's tiles
+// address it), as vglSwapResolution has always done. Off by default: nothing calls these unless the host does.
+
+static int vgl_display_mode_find(int w, int h) {
+	for (int i = 0; i < vgl_display_modes_n; i++)
+		if (vgl_display_modes[i].w == w && vgl_display_modes[i].h == h)
+			return i;
+	return -1;
+}
+static void vgl_display_modes_init(void) {
+	if (vgl_display_modes_n == 0) {
+		vgl_display_modes[0].w = DISPLAY_WIDTH;
+		vgl_display_modes[0].h = DISPLAY_HEIGHT;
+		vgl_display_modes[0].rt = gxm_render_target;
+		vgl_display_modes_n = 1;
+		vgl_display_mode_cur = 0;
+		vgl_display_alloc_w = DISPLAY_WIDTH;
+		vgl_display_alloc_h = DISPLAY_HEIGHT;
+	}
+}
+// Makes the mode ready (a render target of its size). Call at start-up, after vglInit*, before the first switch: creating the target
+// in play would cost a frame. GL_FALSE: not one of the console's modes, larger than the allocation, multisampling or the system
+// application mode on, or the target could not be made.
+GLboolean vglPrepareDisplayMode(int w, int h) {
+	THREAD_SAFE()
+	vgl_display_modes_init();
+	if (vgl_display_mode_find(w, h) >= 0)
+		return GL_TRUE;
+	GLboolean known = (w == 960 && h == 544) || (w == 720 && h == 408) || (w == 640 && h == 368) || (w == 480 && h == 272);
+	if (!known || w > vgl_display_alloc_w || h > vgl_display_alloc_h || msaa_mode != SCE_GXM_MULTISAMPLE_NONE || system_app_mode ||
+		vgl_display_modes_n >= VGL_DISPLAY_MODES_MAX || NEW_DISPLAY_WIDTH)
+		return GL_FALSE;
+	SceGxmRenderTarget *rt = NULL;
+	if (setup_render_target(&rt, w, h, gxm_display_rt_size) != 0 || !rt)
+		return GL_FALSE;
+	vgl_display_modes[vgl_display_modes_n].w = w;
+	vgl_display_modes[vgl_display_modes_n].h = h;
+	vgl_display_modes[vgl_display_modes_n].rt = rt;
+	vgl_display_modes_n++;
+	return GL_TRUE;
+}
+// Switches the display to a prepared mode NOW (for the next display scene and every flip queued after this call). GL_FALSE and nothing
+// changed when the mode is not prepared, or when a display scene of the picture in progress has begun (it is the swap that ends it), or a
+// cheap colour load is armed for the display. GL_TRUE when it is the mode already.
+GLboolean vglSetDisplayMode(int w, int h) {
+	THREAD_SAFE()
+	vgl_display_modes_init();
+	int m = vgl_display_mode_find(w, h);
+	if (m < 0 || NEW_DISPLAY_WIDTH) {
+		vgl_display_refusals++;
+		return GL_FALSE;
+	}
+	if (m == vgl_display_mode_cur)
+		return GL_TRUE;
+	if (vgl_display_scene_open || vgl_color_skip_display_idx >= 0 || vgl_color_skip_armed) {
+		vgl_display_refusals++;
+		return GL_FALSE;
+	}
+	DISPLAY_WIDTH = w;
+	DISPLAY_HEIGHT = h;
+	DISPLAY_WIDTH_FLOAT = w * 1.0f;
+	DISPLAY_HEIGHT_FLOAT = h * 1.0f;
+	DISPLAY_STRIDE = VGL_ALIGN(w, 64);
+	gxm_render_target = vgl_display_modes[m].rt;
+	for (int i = 0; i < gxm_display_buffer_count; i++)
+		sceGxmColorSurfaceInit(&gxm_color_surfaces[i], SCE_GXM_COLOR_FORMAT_A8B8G8R8, SCE_GXM_COLOR_SURFACE_LINEAR, SCE_GXM_COLOR_SURFACE_SCALE_NONE,
+			SCE_GXM_OUTPUT_REGISTER_SIZE_32BIT, DISPLAY_WIDTH, DISPLAY_HEIGHT, DISPLAY_STRIDE, gxm_color_surfaces_addr[i]);
+	// (clear_vertices stay as they are: a full-target quad in local space is (-1, 1, 1, -1) at any size)
+	vgl_display_mode_cur = m;
+	vgl_display_switches++;
+	return GL_TRUE;
+}
+void vglGetDisplayMode(int *w, int *h) {
+	if (w) *w = DISPLAY_WIDTH;
+	if (h) *h = DISPLAY_HEIGHT;
+}
+uint32_t vglGetDisplayModeSwitches(void) { return vgl_display_switches; }
+uint32_t vglGetDisplayModeRefusals(void) { return vgl_display_refusals; }
+uint32_t vglGetDisplayModeFlips(int w, int h) {
+	int m = vgl_display_mode_find(w, h);
+	return m < 0 ? 0 : vgl_display_flips[m];
+}
