 unsigned int gxm_back_buffer_index; // Display back buffer id
 static void (*vgl_display_cb)(void *framebuf) = NULL; // Additional custom callback used inside display queue callback
 
+#ifdef VP28_DIRECT_DISPLAY
+// ---- Patch 0030 (VP28_DIRECT_DISPLAY): a texture that is also a display buffer. Colour surfaces of framebuffer objects made over such a
+// texture begin their scenes with the texture's own sync object (the display's release of the buffer is waited for by the GPU, as for
+// vitaGL's own display buffers), and the texture can be handed to the display queue by vglSwapBuffers instead of vitaGL's own buffer
+// (vglSetNextFlip). Nothing below runs unless the host calls vglMakeDisplayTexture (vgl_dd_n stays 0).
+#define VGL_DD_MAX 16
+static struct { texture *tex; SceGxmSyncObject *sync; } vgl_dd_tab[VGL_DD_MAX];
+int vgl_dd_n = 0; // registered display textures (the hook in gpu_free_texture_data tests it)
+static struct { SceGxmSyncObject *sync; uint32_t frame; } vgl_dd_dead[VGL_DD_MAX]; // retired sync objects (destroyed a few frames later)
+static int vgl_dd_dead_n = 0;
+static texture *vgl_dd_next_tex = NULL;            // armed by vglSetNextFlip: the next swap queues this texture
+static SceGxmSyncObject *vgl_dd_last_sync = NULL;  // the sync object of the entry queued last when it was a texture's (NULL: vitaGL's own front buffer's)
+static uint32_t vgl_dd_flips = 0, vgl_dd_refused = 0, vgl_dd_made = 0;
+static SceGxmSyncObject *vgl_dd_sync_for(const texture *t) {
+	for (int i = 0; i < vgl_dd_n; i++)
+		if (vgl_dd_tab[i].tex == t)
+			return vgl_dd_tab[i].sync;
+	return NULL;
+}
+#define VGL_FBO_SYNC(fb) ((fb)->tex && vgl_dd_n ? vgl_dd_sync_for((fb)->tex) : (SceGxmSyncObject *)NULL)
+// A display texture's storage is let go (gpu_free_texture_data): it stops being one, its sync object is destroyed a few frames from now
+// (the display queue may still hold an entry that names it).
+void vgl_dd_forget(texture *tex) {
+	for (int i = 0; i < vgl_dd_n; i++) {
+		if (vgl_dd_tab[i].tex != tex)
+			continue;
+		if (vgl_dd_next_tex == tex)
+			vgl_dd_next_tex = NULL;
+		if (vgl_dd_dead_n < VGL_DD_MAX) {
+			vgl_dd_dead[vgl_dd_dead_n].sync = vgl_dd_tab[i].sync;
+			vgl_dd_dead[vgl_dd_dead_n].frame = vgl_framecount;
+			vgl_dd_dead_n++;
+		} // (a full list leaks the object: never happens, the host makes a few buffers)
+		if (vgl_dd_last_sync == vgl_dd_tab[i].sync)
+			vgl_dd_last_sync = NULL;
+		vgl_dd_tab[i] = vgl_dd_tab[vgl_dd_n - 1];
+		vgl_dd_n--;
+		return;
+	}
+}
+static void vgl_dd_collect(void) {
+	for (int i = 0; i < vgl_dd_dead_n;) {
+		if (vgl_framecount - vgl_dd_dead[i].frame >= 8) {
+			sceGxmSyncObjectDestroy(vgl_dd_dead[i].sync);
+			vgl_dd_dead[i] = vgl_dd_dead[vgl_dd_dead_n - 1];
+			vgl_dd_dead_n--;
+		} else
+			i++;
+	}
+}
+#else
+#define VGL_FBO_SYNC(fb) ((SceGxmSyncObject *)NULL)
+#endif
+
 static void *gxm_shader_patcher_buffer_addr; // Shader PAtcher buffer memblock starting address
