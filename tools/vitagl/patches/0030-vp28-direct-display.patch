 				if (!r) {
 					vgl_vr_broken = GL_TRUE;
 					vgl_vr_refusals++;
@@ -1282,7 +1336,7 @@
 			if (r && scene_cs != &active_write_fb->colorbuffer) { // (a changed surface refused: as it is, at once)
 				vgl_color_surface_refused(r, "a framebuffer object");
 				scene_cs = &active_write_fb->colorbuffer;
-				r = sceGxmBeginScene(gxm_context, 0, scene_rt, scene_vr, NULL, NULL, scene_cs, scene_ds);
+				r = sceGxmBeginScene(gxm_context, 0, scene_rt, scene_vr, NULL, VGL_FBO_SYNC(active_write_fb), scene_cs, scene_ds);
 			}
 #endif
 #ifdef LOG_ERRORS
@@ -1656,18 +1710,47 @@
 		vgl_display_scene_open = GL_FALSE; // (this picture is queued: the mode may change now)
 		vgl_display_flips[vgl_display_mode_cur]++;
 #endif
+#ifdef VP28_DIRECT_DISPLAY
+		// (patch 0030) the entry's buffers: vitaGL's own, or the texture vglSetNextFlip armed (its sync object is the one its scenes began with).
+		// The "old" side is whatever was queued last, so a texture's entry and vitaGL's own entries chain in the order they were queued.
+		SceGxmSyncObject *dd_new_sync = gxm_sync_objects[gxm_back_buffer_index];
+		SceGxmSyncObject *dd_old_sync = vgl_dd_last_sync ? vgl_dd_last_sync : gxm_sync_objects[gxm_front_buffer_index];
+		const GLboolean dd_foreign = vgl_dd_next_tex != NULL;
+		if (dd_foreign) {
+			dd_new_sync = vgl_dd_sync_for(vgl_dd_next_tex);
+			queue_cb_data.addr = vgl_dd_next_tex->data;
+#ifdef VP27_DISPLAY_MODE
+			queue_cb_data.pitch = sceGxmTextureGetStride(&vgl_dd_next_tex->gxm_tex) / 4; // (pixels; vglMakeDisplayTexture checked the format and size)
+#endif
+			vgl_dd_flips++;
+		}
+		vgl_dd_next_tex = NULL;
+#endif
 #ifdef HAVE_PROFILING
 		tick = sceKernelGetProcessTimeLow();
 #endif
+#ifdef VP28_DIRECT_DISPLAY
+		sceGxmDisplayQueueAddEntry(dd_old_sync, dd_new_sync, &queue_cb_data);
+#else
 		sceGxmDisplayQueueAddEntry(gxm_sync_objects[gxm_front_buffer_index], gxm_sync_objects[gxm_back_buffer_index], &queue_cb_data);
+#endif
 #ifdef HAVE_PROFILING
 		gpu_stall_cnt += sceKernelGetProcessTimeLow() - tick;
 #endif
 #ifdef HAVE_CPU_TRACER
 		sceRazorCpuSync();
 #endif
+#ifdef VP28_DIRECT_DISPLAY
+		vgl_dd_last_sync = dd_foreign ? dd_new_sync : NULL;
