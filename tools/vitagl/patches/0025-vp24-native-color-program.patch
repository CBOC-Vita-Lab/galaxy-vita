+#ifdef VP24_NATIVE_COLOR
+// vglProgramNativeColor (patch 0025, VP24_NATIVE_COLOR): a program whose fragment shader is a __nativecolor Cg program (it reads the
+// colour surface through a FRAGCOLOR input and writes the surface's own bytes: programmable blending) has no fixed-function blending
+// or colour mask to apply; its fragment program is patched with no blend info (as vitaGL's own clear and blit programs are), whatever
+// the GL blend state is. Set it before the program's first draw; the memo of patched programs is emptied.
+void vglProgramNativeColor(GLuint prog, GLboolean on) {
+	if (!prog || prog > MAX_CUSTOM_PROGRAMS)
+		return;
+	program *p = &progs[prog - 1];
+	p->native_color = on ? GL_TRUE : GL_FALSE;
+	vgl_reset_draw_caches(p);
+	p->blend_info.raw = ~blend_info.raw; // (patched again at its next draw)
+}
+#undef rebuild_frag_shader
+#ifdef FBO_MSAA
+#define rebuild_frag_shader(x, y, z, w) patch_fragment_program(x, w, cur_msaa, p->native_color ? NULL : &blend_info.info, z, y)
+#else
+#define rebuild_frag_shader(x, y, z, w) patch_fragment_program(x, w, msaa_mode, p->native_color ? NULL : &blend_info.info, z, y)
+#endif
+#endif
 static inline __attribute__((always_inline)) void vgl_patch_frag_program(program *p, SceGxmOutputRegisterFormat fmt) {
 	if (!(vgl_drawcache_flags & VGL_DRAWCACHE_FRAGMEMO)) {
 		rebuild_frag_shader(p->fshader->id, &p->fprog, (SceGxmProgram *)p->vshader->prog, fmt);
