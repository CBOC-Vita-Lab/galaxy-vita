-void scene_reset(void) {
+// A scene that could not be begun (depth/target allocation or sceGxmBeginScene failed) must not receive a single draw, clear or
+// blit, and must never be ended: scene_reset reports it with GL_FALSE and every caller returns before it submits anything.
+// Bounded retry: at most VGL_SCENE_TRIES_PER_FRAME attempts a frame (so a failing allocator is not hammered by every draw call);
+// after VGL_SCENE_FAIL_LIMIT failed attempts in a row it is a fail-stop (log, abort) instead of a hung console.
+#ifndef VGL_SCENE_TRIES_PER_FRAME
+#define VGL_SCENE_TRIES_PER_FRAME 3
+#endif
+#ifndef VGL_SCENE_FAIL_LIMIT
+#define VGL_SCENE_FAIL_LIMIT 360
+#endif
+static uint32_t scene_fail_frame = 0; // Frame of the latest failed scene begin
+static uint32_t scene_fail_tries = 0; // Failed attempts in that frame
+static uint32_t scene_fail_streak = 0; // Failed attempts since the last scene that began
+
+static GLboolean scene_begin_failed(void) {
+	needs_end_scene = GL_FALSE; // No scene is open: sceGxmEndScene must not follow
+	needs_scene_reset = GL_TRUE; // The next call starts the scene again
+	if (scene_fail_streak == 0 || scene_fail_frame != vgl_framecount) {
+		scene_fail_frame = vgl_framecount;
+		scene_fail_tries = 0;
+	}
+	scene_fail_tries++;
+	if (++scene_fail_streak > VGL_SCENE_FAIL_LIMIT) {
+		vgl_log("%s:%d Scene could not be started %u times in a row: stopping instead of freezing the console.\n", __FILE__, __LINE__, scene_fail_streak - 1);
+		abort();
+	}
+	return GL_FALSE;
+}
+
+GLboolean scene_reset(void) {
 	if (in_use_framebuffer != active_write_fb || needs_scene_reset || dirty_framebuffer || dirty_query) {
+		// The attempts of this frame are used up: nothing is touched, nothing is submitted
+		if (scene_fail_streak && scene_fail_frame == vgl_framecount && scene_fail_tries >= VGL_SCENE_TRIES_PER_FRAME)
+			return GL_FALSE;
 		scene_not_flushed = GL_TRUE;
 		dirty_framebuffer = GL_FALSE;
 		dirty_query = GL_FALSE;
