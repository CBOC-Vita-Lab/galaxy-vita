+// Galaxy direct draw: the current program's enabled attributes (bit per attribute index in `enabled`) from one interleaved buffer
+// object `vbo_name` starting `base` bytes in, at the given offsets; the disabled ones read their glVertexAttrib* constants. 16-bit
+// indices from the bound element array buffer at byte offset idx_offset. `key` must identify everything in the layout but `base`
+// (same key, same table). GL_TRIANGLES only; returns GL_FALSE (nothing drawn) for anything else.
+#define VGL_HAS_DIRECT_DRAW 1
+enum { VGL_DIRECT_F32 = 0, VGL_DIRECT_U8N = 1, VGL_DIRECT_U8 = 2 };
+typedef struct {
+	uint32_t key;
+	uint32_t enabled;
+	uint16_t stride;
+	uint8_t size[16];
+	uint8_t type[16];
+	uint16_t offset[16];
+} vglDirectLayout;
+GLboolean vglDrawElementsDirect(GLenum mode, GLsizei count, uint32_t idx_offset, GLuint vbo_name, uint32_t base, const vglDirectLayout *layout);
+
 // Get the compiled shader binary of a given GL shader.
