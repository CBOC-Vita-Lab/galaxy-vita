# Preserve the selected title background rather than silently shipping a plain loader.
set(smg_loading_path "${sys}/loading-title.rgba")
if(NOT EXISTS "${smg_loading_path}" OR IS_DIRECTORY "${smg_loading_path}")
    message(FATAL_ERROR "Loading artwork is missing: sce_sys/loading-title.rgba")
endif()
file(SIZE "${smg_loading_path}" smg_loading_bytes)
if(NOT smg_loading_bytes EQUAL 2088960)
    message(FATAL_ERROR "Loading artwork must be 960x544 RGBA (2088960 bytes)")
endif()
file(SHA256 "${smg_loading_path}" smg_loading_hash)
if(NOT smg_loading_hash STREQUAL "14529d51dc9e3c4831a20f389b90c162f93ddeafc7567b206fe3b976dd679906")
    message(FATAL_ERROR "Loading artwork SHA-256 does not match the preserved title picture")
endif()
set(smg_loading_picture FILE "${smg_loading_path}" sce_sys/loading-title.rgba)
