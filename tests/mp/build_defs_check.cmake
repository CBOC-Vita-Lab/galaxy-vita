# core2: checks cmake/MpBuildDefs.cmake and prints the compiler flags it gives (one per line, "-D...").
#   cmake -DNP_ONLINE_URL=... -DMP_BUILD_ID=... [-DMP_ALLOW_HTTP_URL=ON] -P tests/mp/build_defs_check.cmake
# (option() and CACHE do not exist in script mode: plain variables stand in)
macro(option name doc default)
  if(NOT DEFINED ${name})
    set(${name} ${default})
  endif()
endmacro()
# (NP_ONLINE_URL left undefined = the build's default, https://galaxy.psvita.dev; "none" = no service)
if(NOT DEFINED NP_ONLINE_URL)
  set(NP_ONLINE_URL "https://galaxy.psvita.dev")
endif()
if(NOT DEFINED MP_BUILD_ID)
  set(MP_BUILD_ID "dev")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/MpBuildDefs.cmake")
foreach(d IN LISTS MP_BUILD_DEFS)
  message("-D${d}")
endforeach()
